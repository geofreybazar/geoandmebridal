# Copy to .env.local and fill in. Never commit .env.local (ignored by .gitignore).
# Production values live in the Vercel project settings. Full list: docs/ENVIRONMENT.md
# NEXT_PUBLIC_* values end up in the browser: never put a secret in one.

# --- Auth.js ---
AUTH_SECRET=<long random string>
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=<Google OAuth client id>
AUTH_GOOGLE_SECRET=<Google OAuth client secret>
AUTH_FACEBOOK_ID=<Facebook app id>
AUTH_FACEBOOK_SECRET=<Facebook app secret>

# Same value as CLIENT_API_SECRET in new_backend/.env; at least 32 characters
CLIENT_API_SECRET=<long random string>

# --- reCAPTCHA v3 ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<site key>
RECAPTCHA_SECRET_KEY=<secret key>
# RECAPTCHA_HOSTNAMES=localhost,127.0.0.1

# --- backend ---
# Optional: defaults to the Render backend in production builds, else http://localhost:3005
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3005
PAGE_LIMIT=12
NEXT_PUBLIC_APPOINTMENT_ROUTE=appointment_api
NEXT_PUBLIC_BRIDE_ROUTE=bride_api
NEXT_PUBLIC_CART_ROUTE=cart_api
NEXT_PUBLIC_CHECKOUT_ROUTE=checkout_api
NEXT_PUBLIC_CLIENT_ROUTE=client_api
NEXT_PUBLIC_COLLECTION_ROUTE=collection_api
NEXT_PUBLIC_CUSTOM_ORDER_ROUTE=customorder_api
NEXT_PUBLIC_PAYMENT_REQUEST_ROUTE=paymentrequest_api
NEXT_PUBLIC_PRODUCT_ROUTE=product_api
NEXT_PUBLIC_SHOP_ORDER_ROUTE=shoporder_api
